# Copy to .env and fill in. Never commit .env.
# Get a key at https://data.gov.sg (sign in, then API keys). Send it as the x-api-key header.
DATA_GOV_SG_API_KEY=
DATA_GOV_SG_API_KEY_DEV=
# Optional. Lets the map's "Tell us about your shop" box read text and photos with Claude.
# Without it the box matches keywords. Get a key at https://platform.claude.com.
ANTHROPIC_API_KEY=

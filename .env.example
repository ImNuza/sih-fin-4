# Copy to .env and fill in. Never commit .env.
# Get a key at https://data.gov.sg (sign in, then API keys). Send it as the x-api-key header.
DATA_GOV_SG_API_KEY=
DATA_GOV_SG_API_KEY_DEV=
# Optional. Any one key lets the map's "Tell us about your shop" box read text and photos with a
# model (Claude first, then OpenAI, then Grok). With none, the box matches keywords.
# Keys: https://platform.claude.com, https://platform.openai.com and https://console.x.ai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional: the Payung assistant (chat button on every page) asks DeepSeek first, then Grok
# (XAI_API_KEY), then OpenAI. With none it still answers, from keywords and templates.
# Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional: with no key above, the assistant uses a local model through Ollama, so nothing leaves
# this machine (brew install ollama; ollama serve; ollama pull qwen3:8b). It writes English and
# Chinese replies itself; Malay and Tamil replies are translated by NLLB-200 (downloaded on first
# use, about 600 MB, non-commercial licence). Voice: Whisper on this machine (first use downloads
# about 1.5 GB) and neural voices through edge-tts (needs internet).
OLLAMA_MODEL=
WHISPER_MODEL=

# Optional: text real phones through textbee.dev (api/sms_gateway.py), sent from an Android phone
# running the textbee app. Without it, texts are simulated and only show on the dashboard.
TEXTBEE_API_KEY=

# Optional: the demo phone, e.g. +6591234567. The insurer's demo card fills it in, and a demo payout
# goes to it when the insurer types no mobile and the customer has no verified one.
# Kept here, not in code, because it is a real person's number.
DEMO_PAYOUT_MOBILE=

# Optional, for hosting: the public address the PayNow demo QR links to, e.g.
# https://payung.nuza.dev. Leave unset on a laptop: the QR then uses the laptop's Wi-Fi address.
PUBLIC_SITE_URL=

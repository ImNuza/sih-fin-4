# Copy to .env and fill in. Never commit .env.
# Get a key at https://data.gov.sg (sign in, then API keys). Send it as the x-api-key header.
DATA_GOV_SG_API_KEY=
DATA_GOV_SG_API_KEY_DEV=
# Optional. Either key lets the map's "Tell us about your shop" box read text and photos with a
# model (Claude is used when both are set). With neither, the box matches keywords.
# Keys: https://platform.claude.com and https://platform.openai.com.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
